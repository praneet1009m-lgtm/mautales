{
  "name": "mau-scrapbook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prerender": "node prerender.mjs",
    "build:full": "vite build && (vite preview --port 4210 --strictPort & sleep 2; node prerender.mjs; kill %1) && vite build",
    "format": "prettier --write index.html src prerender.mjs",
    "format:check": "prettier --check index.html src prerender.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.11",
    "lenis": "^1.3.27",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "vite": "^5.4.21"
  }
}
